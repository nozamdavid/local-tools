{$LOCONVERT_SITE} {
	root * {$LOCONVERT_ROOT:/srv/loconvert}/current

	# The publish procedure adds only Vite's content-hashed outputs to this root.
	@hashed path_regexp ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.[A-Za-z0-9]+$
	handle @hashed {
		root * {$LOCONVERT_ROOT:/srv/loconvert}/shared
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Keep missing files out of the SPA fallback, including stable public assets.
	@file path_regexp ^/(assets(/|$)|.*\.[^/]+/?$)
	handle @file {
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		rewrite * /index.html
		file_server
	}

	handle_errors {
		header Cache-Control "no-store"
		respond "{http.error.status_text}" {http.error.status_code}
	}
}
